<?xml version="1.0" encoding="utf-8"?>
<!--
  媒体管理行卡片：左侧缩略块（已完成显示封面 / 无封面显示 ▶）+ 标题 + 副信息，
  右侧状态文字 + ⋮。颜色由 tintTaskRow() 按深色模式开关显式着色。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/task_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_task_card"
    android:paddingStart="12dp"
    android:paddingEnd="4dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp">

    <!-- 缩略块：▶ 在下层兜底，抽到帧后 ImageView 铺满盖住它（缩到 64×44dp） -->
    <FrameLayout
        android:id="@+id/task_thumb_box"
        android:layout_width="64dp"
        android:layout_height="44dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_rec_thumb">

        <TextView
            android:id="@+id/task_play"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="▶"
            android:textColor="@color/tab_selected"
            android:textSize="18sp"
            android:contentDescription="播放" />

        <ImageView
            android:id="@+id/task_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="封面" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/task_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="视频标题"
            android:textColor="@color/text_main"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/task_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="原画 · 11-14 09:38"
            android:textColor="@color/task_sub"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/task_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="已下载"
        android:textColor="@color/tab_selected"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/task_more"
        android:layout_width="40dp"
        android:layout_height="56dp"
        android:gravity="center"
        android:text="⋮"
        android:textColor="@color/task_sub"
        android:textSize="22sp"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="更多操作" />

</LinearLayout>
