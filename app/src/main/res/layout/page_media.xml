<?xml version="1.0" encoding="utf-8"?>
<!--
  媒体管理：顶部「全部/视频/音频/任务/下载」文字标签导航栏（保持不变，带选中下划线），
  没有底部分类胶囊栏；整页配色引用随主题切换的 @color，
  由设置页已有的「深色模式」开关（ThemeMode）控制明暗。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page_media_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <!-- 顶部导航栏：5 个文字标签 + 选中项下方蓝色短下划线 -->
    <LinearLayout
        android:id="@+id/tab_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/tab_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="全部"
                android:textColor="@color/tab_normal"
                android:textSize="16sp"
                android:paddingBottom="6dp"
                android:clickable="true"
                android:focusable="true" />
            <View
                android:id="@+id/ind_all"
                android:layout_width="26dp"
                android:layout_height="3dp"
                android:background="@drawable/bg_tab_indicator"
                android:visibility="invisible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/tab_video"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="视频"
                android:textColor="@color/tab_normal"
                android:textSize="16sp"
                android:paddingBottom="6dp"
                android:clickable="true"
                android:focusable="true" />
            <View
                android:id="@+id/ind_video"
                android:layout_width="26dp"
                android:layout_height="3dp"
                android:background="@drawable/bg_tab_indicator"
                android:visibility="invisible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/tab_audio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="音频"
                android:textColor="@color/tab_normal"
                android:textSize="16sp"
                android:paddingBottom="6dp"
                android:clickable="true"
                android:focusable="true" />
            <View
                android:id="@+id/ind_audio"
                android:layout_width="26dp"
                android:layout_height="3dp"
                android:background="@drawable/bg_tab_indicator"
                android:visibility="invisible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/tab_task"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="任务"
                android:textColor="@color/tab_selected"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="6dp"
                android:clickable="true"
                android:focusable="true" />
            <View
                android:id="@+id/ind_task"
                android:layout_width="26dp"
                android:layout_height="3dp"
                android:background="@drawable/bg_tab_indicator"
                android:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:id="@+id/tab_download"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="下载"
                android:textColor="@color/tab_normal"
                android:textSize="16sp"
                android:paddingBottom="6dp"
                android:clickable="true"
                android:focusable="true" />
            <View
                android:id="@+id/ind_download"
                android:layout_width="26dp"
                android:layout_height="3dp"
                android:background="@drawable/bg_tab_indicator"
                android:visibility="invisible" />
        </LinearLayout>

    </LinearLayout>

    <!-- 图1：标签栏下方的淡色细分隔线（颜色由 applyMediaTheme() 按开关显式设置） -->
    <View
        android:id="@+id/tab_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/set_stroke" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/task_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/task_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="100dp" />
        </ScrollView>

        <TextView
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal|top"
            android:paddingTop="110dp"
            android:text="没有数据(^▽^)"
            android:textColor="@color/empty_text"
            android:textSize="15sp" />

    </FrameLayout>

</LinearLayout>
