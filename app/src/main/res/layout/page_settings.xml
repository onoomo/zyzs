<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页：按 DownX 原版 1:1 还原（深色卡片 / 分组 / 蓝色开关 / 账号图标胶囊）。
  按用户要求删去：顶部「< 设置」标题栏、整个「安全 / 应用锁」分组、
  「支持作者 / 请我喝咖啡」卡片、底部版本脚注。
  「使用说明与支持平台」单独保留一行，点击进入移植过来的 HelpActivity；
  「逐条管理文件」点击进入移植过来的 FilesActivity（含多选 / 批量删除 / 单条搬家）。
  背景铺满贴顶全屏，底部留白给悬浮透明胶囊；卡片配色跟随明暗，开关接 Prefs/Store 真实逻辑。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/set_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/settings_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="8dp"
        android:paddingBottom="100dp">

        <!-- 分组从「下载」开始：顶部「安全 / 应用锁」整组已按用户要求删除 -->

        <!-- ===== 外观：明暗切换（用户新增） ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginStart="6dp"
            android:letterSpacing="0.08"
            android:text="外观"
            android:textColor="@color/set_faint"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/set_bg_card"
            android:gravity="center_vertical"
            android:minHeight="66dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="深色模式"
                    android:textColor="@color/set_text"
                    android:textSize="14.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="切换后首页与媒体管理的明暗立即生效"
                    android:textColor="@color/set_faint"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <Switch
                android:id="@+id/sw_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumb="@drawable/set_switch_thumb"
                android:track="@drawable/set_switch_track"
                android:textOn=""
                android:textOff=""
                android:switchMinWidth="44dp" />
        </LinearLayout>

        <!-- ===== 下载 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginStart="6dp"
            android:letterSpacing="0.08"
            android:text="下载"
            android:textColor="@color/set_faint"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/set_bg_card"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <!-- 保存到相册 + 开关 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="66dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="保存到相册"
                        android:textColor="@color/set_text"
                        android:textSize="14.5sp" />

                    <TextView
                        android:id="@+id/tv_gallery_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingExtra="2dp"
                        android:text="新下载的文件存进相册，相册里能看到"
                        android:textColor="@color/set_faint"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <Switch
                    android:id="@+id/sw_gallery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/set_switch_thumb"
                    android:track="@drawable/set_switch_track"
                    android:textOn=""
                    android:textOff=""
                    android:switchMinWidth="44dp" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/set_stroke" />

            <!-- 逐条管理文件 -->
            <LinearLayout
                android:id="@+id/row_files"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="逐条管理文件"
                        android:textColor="@color/set_text"
                        android:textSize="14.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="单独决定某一条在不在相册里"
                        android:textColor="@color/set_faint"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_files_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="全部可见"
                    android:textColor="@color/set_faint"
                    android:textSize="12.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/set_faint"
                    android:textSize="16sp" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/set_stroke" />

            <!-- 重新扫描相册 -->
            <LinearLayout
                android:id="@+id/row_rescan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="重新扫描相册"
                        android:textColor="@color/set_text"
                        android:textSize="14.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="把手机上还在、列表里没有的下载补回来"
                        android:textColor="@color/set_faint"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/set_faint"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 账号 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:text="账号"
                android:textColor="@color/set_faint"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="不登录也能下载"
                android:textColor="@color/set_ok"
                android:textSize="10.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/set_bg_card"
            android:orientation="vertical">

            <!-- 哔哩哔哩 -->
            <LinearLayout
                android:id="@+id/row_bili"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="13dp"
                android:paddingEnd="14dp"
                android:paddingBottom="13dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/set_tile_bili">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="B"
                        android:textColor="#4EA6F5"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="哔哩哔哩"
                            android:textColor="@color/set_text"
                            android:textSize="14.5sp" />

                        <TextView
                            android:id="@+id/tv_bili_state"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/set_chip"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:text="未登录"
                            android:textColor="@color/set_dim"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_bili_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"
                        android:text="不登录：最高 720P；登录后：1080P / 大会员 4K 原画"
                        android:textColor="@color/set_faint"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="›"
                    android:textColor="@color/set_faint"
                    android:textSize="16sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="66dp"
                android:background="@color/set_stroke" />

            <!-- Instagram -->
            <LinearLayout
                android:id="@+id/row_ig"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="13dp"
                android:paddingEnd="14dp"
                android:paddingBottom="13dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/set_tile_ig">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="Instagram"
                        android:src="@drawable/set_ic_ig" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Instagram"
                            android:textColor="@color/set_text"
                            android:textSize="14.5sp" />

                        <TextView
                            android:id="@+id/tv_ig_state"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/set_chip"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:text="未登录"
                            android:textColor="@color/set_dim"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_ig_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"
                        android:text="不登录：公开帖直接能下；登录后：多档清晰度 + 私密内容"
                        android:textColor="@color/set_faint"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="›"
                    android:textColor="@color/set_faint"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:lineSpacingExtra="2dp"
            android:text="登录完全可选：不登录照样能下载，差别只在清晰度上限和能不能下受限内容。账号信息只存在本机，不上传。"
            android:textColor="@color/set_faint"
            android:textSize="10.5sp" />

        <!-- 使用说明与支持平台：进入移植过来的 HelpActivity（不含「支持作者」） -->
        <LinearLayout
            android:id="@+id/row_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="@drawable/set_bg_card"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="使用说明与支持平台"
                    android:textColor="@color/set_text"
                    android:textSize="14.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="支持哪些平台 · 怎么用"
                    android:textColor="@color/set_faint"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="@color/set_faint"
                android:textSize="16sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
