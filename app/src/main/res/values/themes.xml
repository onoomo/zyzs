<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 平台原生主题，NoActionBar：没有任何顶栏，也不需要 AppCompat 依赖 -->
    <style name="Theme.ImmersiveTwoBox" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!--
          挖孔屏 / 刘海：窗口创建首帧就允许内容延伸到短边挖孔区（API 28+）。
          该属性在低版本系统上会被忽略，不会报错；代码里 configureBars() 会再设一次双保险。
        -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="DialogPopAnim">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>
    <!-- 嗅探页专用：框架 Material 主题的 Button 有大 minWidth/内边距，会把顶栏挤爆。
         这里压平成原版 MaterialComponents 观感（紧凑、不加投影、不强制大写）。 -->
    <style name="SniffBtn" parent="android:Widget.Material.Button">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Theme.ImmersiveTwoBox.Sniff" parent="Theme.ImmersiveTwoBox">
        <item name="android:buttonStyle">@style/SniffBtn</item>
    </style>
</resources>
